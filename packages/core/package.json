{
  "name": "@vue-pivot/core",
  "version": "0.1.0",
  "description": "Lazy pivot engine: query/command protocol, dim trees, aggregators, cube and viewport",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "big.js": "^6.2.2"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
